<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="apartment">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <pose>0 0 8 0 0 0</pose>
        <geometry>
          <box>
            <size>12 10 16</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://apartment/meshes/apartment.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://apartment/materials/textures/apartment_diffuse.jpg</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
