    <!--
      ================================================================
      sidewalk_16 정적 장애물 회피 코스 (w5, 보도 폭 5m 전용)
      ================================================================
      로봇은 (15.0, 5.2)에서 +x로 주행.  x 5m 간격 5개 스테이션이 통과
      게이트를 남/북으로 교대시켜 횡방향 회피를 강제한다.

      밴드: y 1.90~6.35 (sidewalk_polygon_w5.yaml).  보도 물리 외곽은
      y 1.7~6.7, 상면 z=0.15 이므로 모든 장애물은 z=0.15에 놓는다
      (cardboard_box만 중심 원점이라 z=0.30).

      통과 가능성 근거: 안전게이트 회랑 0.67m (robot_half_width 0.155 +
      corridor_margin 0.18, 양측), Nav2 footprint 외접원 0.83m.  게이트는
      1.30~1.64m라 양측 0.23m 이상 여유.  반대로 차단측 잔여 틈은 전부
      0.67m 미만이라 통과 후보가 되지 않는다.

        스테이션   게이트 y        폭      중심
        S1 x=18.5  4.81~6.35     1.54m   5.58 (북)
        S2 x=23.5  1.90~3.34     1.44m   2.62 (남)
        S3 x=28.5  5.05~6.35     1.30m   5.70 (북)
        S4 x=33.5  1.90~3.54     1.64m   2.72 (남)
        S5 x=38.0  3.36~4.80     1.44m   4.08 (중앙)
    -->

    <!-- S1 x=18.5 — 남측 볼라드 열(피치 0.55, 기둥 사이 0.43m), 게이트 북측 -->
    <include>
      <name>w5_s1_bollard_1</name>
      <pose>18.5 2.00 0.15 0 0 0</pose>
      <uri>model://bollard</uri>
    </include>
    <include>
      <name>w5_s1_bollard_2</name>
      <pose>18.5 2.55 0.15 0 0 0</pose>
      <uri>model://bollard</uri>
    </include>
    <include>
      <name>w5_s1_bollard_3</name>
      <pose>18.5 3.10 0.15 0 0 0</pose>
      <uri>model://bollard</uri>
    </include>
    <include>
      <name>w5_s1_bollard_4</name>
      <pose>18.5 3.65 0.15 0 0 0</pose>
      <uri>model://bollard</uri>
    </include>
    <include>
      <name>w5_s1_bollard_5</name>
      <pose>18.5 4.20 0.15 0 0 0</pose>
      <uri>model://bollard</uri>
    </include>
    <include>
      <name>w5_s1_bollard_6</name>
      <pose>18.5 4.75 0.15 0 0 0</pose>
