    <!-- Sidewalks -->

    <!--
      Drift diagnostic: replace the spawn sidewalk's original tall box
      collision with a shallow raised slab.  The slab bottom is at the visual
      sidewalk top (z=0.15) and its top is at z=0.17, so it tests whether
      reducing visible/physical penetration improves Go2 foot contact.
    -->
    <model name="sidewalk_16_raised_collision_test">
      <static>true</static>
      <pose>15.000000 4.2 0.160000 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>52.600000 5.0 0.01</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>
    </model>

