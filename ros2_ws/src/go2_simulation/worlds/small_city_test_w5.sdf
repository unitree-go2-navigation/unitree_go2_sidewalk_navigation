<?xml version="1.0" ?>

<sdf version="1.6">
<!--
  small_city_test_w5 — 보도 폭 5.0m (표준 3.0m 대비 남측 확장).
  용도: 추후 결정 (2026-07-29 기준 미정 — 사용자 지정 예정).
  월드 4종 사용 의도:
    - small_city_test     (보도 3m): 표준 반복 실험 (좁은 보도 스트레스)
    - small_city_test_w5  (보도 5m): 용도 추후 결정
    - small_city_test_w7  (보도 7m): 다수 장애물·군중 액터 시나리오 무대
    - small_city (원본 도시): 최종 알고리즘 완성 후 실기체 전이 전 테스트
  노변 물체·액터는 비워둠 — 시나리오에서 명시적으로 배치.
  생성: verification/gen_wide_worlds.py (small_city_test.sdf 기반)
-->
  <world name="default">

    <gui>
     <camera name="user_camera">
       <pose>-40.637 0.86 2.365 0 0.1899 0.476</pose>
     </camera>
    </gui>
    <scene>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
      <ambient>0.85 0.85 0.85 1</ambient>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
      <background>0.35 0.35 0.35 1.0</background>
    </scene>

    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <!-- 0.25 캡: L1 GPU 라이다의 벽시계 상한이 이 머신에서 ~2.5Hz(월드
           무관 실측, 2026-07-23). 원본 small_city는 부하로 자연히 RTF~0.5
           가 되어 심 시간 L1 ~5Hz를 유지했고 P4~P5 튜닝이 전부 그 조건
           기준. 축소 월드가 RTF 1.0으로 돌면 심 시간 2.5Hz로 떨어져
           게이트 sensor_timeout 연발 → 동일 조건 재현을 위한 캡.
           풀스택(원본) 실측 RTF 0.13~0.33·L1 심 ~7.5Hz 기준 0.25. -->
      <real_time_factor>0.25</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>5.5645e-06 2.28758e-05 -4.23884e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- Publishes actor + configured-model WorldPose for evaluation oracle (not used by avoidance) -->
    <plugin name='go2_simulation::ActorPosePublisher' filename='ActorPosePublisher'>
      <topic>/world/default/actor_pose/info</topic>
      <update_rate>50</update_rate>
      <frame_id>world</frame_id>
      <model_name>go2</model_name>
    </plugin>

    <!-- A global light source -->
    <light type="directional" name="sun">
      <pose>0 0 1000 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.4</direction>
    </light>

    <!-- ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <pose>0 0 -1 0 0 0</pose>
      </link>
    </model>

    <!-- Environment -->
    <include>
      <name>city_terrain_1</name>
      <pose>
      0
      0
      0.0
      0
      0
      0
      </pose>
      <uri>model://city_terrain</uri>
    </include>



    <!-- Base plane to cover ocean exposure in city blocks -->
    <model name="city_base_plane">
      <static>true</static>
      <pose>37.5 0 -8 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box>
              <size>170 95 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.75 0.70 0.55 1</ambient>
            <diffuse>0.75 0.70 0.55 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>170 95 0.01</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>
    </model>


