<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="House 2">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://house_2/meshes/house_2.dae</uri>
            <scale>1.5 1.5 1.5</scale>
          </mesh>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://house_2/meshes/house_2.dae</uri>
            <scale>1.5 1.5 1.5</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://house_2/materials/textures/House_2_Diffuse.png</albedo_map>
            </metal>
          </pbr>
          <!-- Re-enable when normal maps work again
          <shader type="normal_map_object_space">
            <normal_map>model://house_1/materials/textures/House_1_Normal.png</normal_map>
          </shader-->
        </material>
      </visual>
    </link>
  </model>
</sdf>
